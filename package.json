{
  "name": "rymedb-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "check": "turbo run check",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "docs:dev": "node scripts/prepare-docs.mjs && docusaurus start",
    "docs:build": "node scripts/prepare-docs.mjs && docusaurus build",
    "docs:build:ci": "node scripts/prepare-docs.mjs && docusaurus build --out-dir _site",
    "docs:serve": "docusaurus serve",
    "prepare": "husky"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mermaid-js/layout-elk": "0.1.9",
    "@scalar/docusaurus": "^0.8.50",
    "husky": "^9.1.7",
    "mermaid": "11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turbo": "2.11.3",
    "typescript": "7.0.2"
  },
  "description": "rymeDB is an open-source, ultra-low-latency distributed relational database and backend platform. One static `ryme-server` binary serves PostgreSQL wire protocol clients, RESP (Valkey-compatible) clients, and a REST operator API.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": []
}
