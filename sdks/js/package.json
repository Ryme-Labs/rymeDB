{
  "name": "@rymelabs/rymedb",
  "version": "3.0.0",
  "type": "module",
  "description": "Typed npm client for the rymeDB HTTP and realtime APIs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryme-Labs/rymeDB.git",
    "directory": "sdks/js"
  },
  "homepage": "https://ryme-labs.github.io/rymeDB/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/*.test.js"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.3"
  }
}
